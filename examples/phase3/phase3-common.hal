# Dedicated virtual-machine example. Uses the ORIGINAL installed HAL driver.
# No physical machine drivers, GPIO or EtherCAT are loaded. The versioned
# wrapper has already loaded LinuxCNC's standard real/float-to-uint converter.
loadrt [KINS]KINEMATICS
loadrt [EMCMOT]EMCMOT servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS num_spindles=[TRAJ]SPINDLES
loadrt stepgen-ninja ip_address="192.168.50.2:8888"
loadrt near count=1

addf motion-command-handler servo-thread
addf motion-controller servo-thread
# Convert LinuxCNC's absolute RPM command before this cycle's UDP request.
addf spindle-speed-converter servo-thread
addf stepgen-ninja.0.watchdog-process servo-thread
addf stepgen-ninja.0.process-send servo-thread
addf stepgen-ninja.0.process-recv servo-thread
# Evaluate at-speed after receiving this cycle's encoder velocity feedback.
addf near.0 servo-thread

setp stepgen-ninja.0.stepgen.pulse-width 2500
setp stepgen-ninja.0.stepgen.0.step-scale [JOINT_0]INPUT_SCALE
setp stepgen-ninja.0.stepgen.1.step-scale [JOINT_1]INPUT_SCALE
setp stepgen-ninja.0.stepgen.2.step-scale [JOINT_2]INPUT_SCALE
setp stepgen-ninja.0.stepgen.3.step-scale 400
setp stepgen-ninja.0.stepgen.0.mode 0
setp stepgen-ninja.0.stepgen.1.mode 0
setp stepgen-ninja.0.stepgen.2.mode 0
setp stepgen-ninja.0.stepgen.3.mode 0
setp stepgen-ninja.0.stepgen.3.enable 0

# Spindle channel 0: RPM is the PWM scale and direction is a separate GPIO.
setp spindle-speed-converter.clamp true
setp stepgen-ninja.0.pwm.0.enable true
setp stepgen-ninja.0.pwm.0.frequency 10000
setp stepgen-ninja.0.pwm.0.max-scale 24000
setp stepgen-ninja.0.pwm.0.min-limit 0
setp stepgen-ninja.0.encoder.0.scale 1024
setp near.0.scale 1.10
setp near.0.difference 1.0

net x-cmd joint.0.motor-pos-cmd => stepgen-ninja.0.stepgen.0.command
net y-cmd joint.1.motor-pos-cmd => stepgen-ninja.0.stepgen.1.command
net z-cmd joint.2.motor-pos-cmd => stepgen-ninja.0.stepgen.2.command
# The original driver's feedback is its local command copy, not a network position.
net x-fb stepgen-ninja.0.stepgen.0.feedback => joint.0.motor-pos-fb
net y-fb stepgen-ninja.0.stepgen.1.feedback => joint.1.motor-pos-fb
net z-fb stepgen-ninja.0.stepgen.2.feedback => joint.2.motor-pos-fb
net x-enable joint.0.amp-enable-out => stepgen-ninja.0.stepgen.0.enable
net y-enable joint.1.amp-enable-out => stepgen-ninja.0.stepgen.1.enable
net z-enable joint.2.amp-enable-out => stepgen-ninja.0.stepgen.2.enable

# LinuxCNC remains the interpreter/controller. M3/M4/M5/S reach the simulator
# only as the normal Stepper-Ninja PWM, GPIO and encoder protocol fields.
net spindle-enable spindle.0.on => stepgen-ninja.0.output.gp8
net spindle-reverse spindle.0.reverse => stepgen-ninja.0.output.gp12
net spindle-speed-abs spindle.0.speed-out-abs => spindle-speed-converter.in
net spindle-pwm-duty spindle-speed-converter.out => stepgen-ninja.0.pwm.0.duty

# Standard LinuxCNC spindle feedback is revolutions and revolutions/second.
net spindle-revs stepgen-ninja.0.encoder.0.position => spindle.0.revs
net spindle-speed-rps stepgen-ninja.0.encoder.0.velocity-rps => spindle.0.speed-in near.0.in2
net spindle-command-rps spindle.0.speed-out-rps => near.0.in1
net spindle-at-speed near.0.out => spindle.0.at-speed
net spindle-index-enable spindle.0.index-enable <=> stepgen-ninja.0.encoder.0.index-enable

net sim-enable iocontrol.0.user-enable-out => stepgen-ninja.0.io-ready-in
net sim-ready stepgen-ninja.0.io-ready-out => iocontrol.0.emc-enable-in
net tool-prepare iocontrol.0.tool-prepare => iocontrol.0.tool-prepared
net tool-change iocontrol.0.tool-change => iocontrol.0.tool-changed

# Original Board-0 HAL exports only GP22/26/27/28. Min and max sensors
# share one physical input per axis (OR). Both limit pins and home see it.
net x-switch stepgen-ninja.0.input.gp22 => joint.0.home-sw-in joint.0.neg-lim-sw-in joint.0.pos-lim-sw-in
net y-switch stepgen-ninja.0.input.gp26 => joint.1.home-sw-in joint.1.neg-lim-sw-in joint.1.pos-lim-sw-in
net z-switch stepgen-ninja.0.input.gp27 => joint.2.home-sw-in joint.2.neg-lim-sw-in joint.2.pos-lim-sw-in
net probe-contact stepgen-ninja.0.input.gp28 => motion.probe-input
